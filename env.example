# Kopeje so failu uz ".env" un ievieto savas vertibas

# Anthropic (Claude) API atslega
# Sanem to no: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Servera ports (parasti nav nepieciesams mainit)
PORT=3000

# PIEZIME: Twilio atslegas NAV nepieciesams likt sinī failā —
# Twilio autentifikacija notiek to platformas puse, kad tu
# konfigure webhook URL Twilio konsole. Sim vienkarsajam
# piemeram tas nav nepieciesams servera koda.
